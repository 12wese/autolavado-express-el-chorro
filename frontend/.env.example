# Para desarrollo, copia este archivo como .env.development.local dentro de frontend/.
# Supabase local (supabase start). Sustituye la clave por la anon/public local
# mostrada por `supabase status`; nunca uses service_role en el frontend.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="your-local-anon-key"

# Entorno remoto: descomenta y reemplaza solo con placeholders/valores publicables
# de un proyecto autorizado. No uses service_role ni credenciales privadas.
# VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<your-public-key>"

VITE_FUSEKI_ENDPOINT=http://localhost:3030/Autolavado
