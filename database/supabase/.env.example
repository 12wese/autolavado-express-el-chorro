# Configure AI_VISION_API_KEY or GEMINI_API_KEY locally; never commit real keys.
AI_VISION_PROVIDER=gemini
AI_VISION_API_KEY=replace-with-your-provider-key
# GEMINI_API_KEY=replace-with-your-gemini-key
# Local Docker endpoint; use a reachable, protected Fuseki URL for hosted Supabase.
FUSEKI_ENDPOINT=http://host.docker.internal:3030/Autolavado
