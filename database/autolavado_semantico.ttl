@prefix : <https://elchorro.example/ontologia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontología inicial del Autolavado Express El Chorro.
# El dominio .example es deliberadamente provisional; antes de producción
# se debe reemplazar por un IRI estable bajo un dominio que controle el proyecto.

:AutolavadoOntologia a owl:Ontology ;
    rdfs:label "Ontología del Autolavado Express El Chorro"@es ;
    rdfs:comment "Versión inicial para prototipo local en Protégé y Apache Jena Fuseki."@es ;
    rdfs:comment "El grafo no reemplaza Supabase. Supabase sigue siendo la fuente operacional y de permisos."@es ;
    owl:versionInfo "0.1.0" .

#################################################################
# Clases
#################################################################

:TrabajoLavado a owl:Class ;
    rdfs:label "Trabajo de lavado"@es ;
    rdfs:comment "Una operación de lavado registrada por el sistema."@es .

:Vehiculo a owl:Class ;
    rdfs:label "Vehículo"@es ;
    rdfs:comment "Vehículo asociado a uno o más trabajos de lavado."@es .

:Lavador a owl:Class ;
    rdfs:label "Lavador"@es .

:TipoVehiculo a owl:Class ;
    rdfs:label "Tipo de vehículo"@es .

:Servicio a owl:Class ;
    rdfs:label "Servicio"@es .

:Adicion a owl:Class ;
    rdfs:label "Adición"@es .

:EstadoLavado a owl:Class ;
    rdfs:label "Estado del lavado"@es .

:Negocio a owl:Class ;
    rdfs:label "Negocio"@es ;
    rdfs:comment "Unidad propuesta para separar los datos compartidos del autolavado. Las tablas actuales usan user_id y aún no tienen business_id."@es .

:TarifaServicio a owl:Class ;
    rdfs:label "Tarifa de servicio"@es ;
    rdfs:comment "Precio de un servicio para un tipo de vehículo y un negocio. Representa la tabla service_prices, sin inventar precios."@es .

#################################################################
# Object properties: relaciones entre individuos
#################################################################

:realizadoPor a owl:ObjectProperty ;
    rdfs:label "realizado por"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :Lavador ;
    rdfs:comment "El lavador asignado al trabajo. La aplicación actualmente guarda washer_name como texto; para una sincronización fiable se requiere un identificador estable."@es .

:tieneTipoVehiculo a owl:ObjectProperty ;
    rdfs:label "tiene tipo de vehículo"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :TipoVehiculo .

:tieneVehiculo a owl:ObjectProperty ;
    rdfs:label "tiene vehículo"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :Vehiculo .

:incluyeServicio a owl:ObjectProperty ;
    rdfs:label "incluye servicio"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :Servicio ;
    rdfs:comment "Un trabajo puede incluir más de un servicio. En algunos flujos actuales los servicios múltiples se guardan como texto combinado; deben normalizarse al sincronizar."@es .

:incluyeAdicion a owl:ObjectProperty ;
    rdfs:label "incluye adición"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :Adicion ;
    rdfs:comment "Solo se debe poblar cuando la selección de adiciones quede persistida junto al trabajo. El flujo QR actual calcula el total, pero no guarda la asociación de cada adición."@es .

:tieneEstado a owl:ObjectProperty ;
    rdfs:label "tiene estado"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :EstadoLavado .

:perteneceA a owl:ObjectProperty ;
    rdfs:label "pertenece al negocio"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range :Negocio ;
    rdfs:comment "Relación propuesta para el modelo multiusuario. No implica que la tabla actual ya contenga business_id."@es .

:trabajaEn a owl:ObjectProperty ;
    rdfs:label "trabaja en"@es ;
    rdfs:domain :Lavador ;
    rdfs:range :Negocio .

:adicionOfrecidaPor a owl:ObjectProperty ;
    rdfs:label "adición ofrecida por"@es ;
    rdfs:domain :Adicion ;
    rdfs:range :Negocio .

:tarifaParaServicio a owl:ObjectProperty ;
    rdfs:label "tarifa para servicio"@es ;
    rdfs:domain :TarifaServicio ;
    rdfs:range :Servicio .

:tarifaParaTipoVehiculo a owl:ObjectProperty ;
    rdfs:label "tarifa para tipo de vehículo"@es ;
    rdfs:domain :TarifaServicio ;
    rdfs:range :TipoVehiculo .

:tarifaOfrecidaPor a owl:ObjectProperty ;
    rdfs:label "tarifa ofrecida por"@es ;
    rdfs:domain :TarifaServicio ;
    rdfs:range :Negocio .

#################################################################
# Data properties: atributos con valores literales
#################################################################

:precio a owl:DatatypeProperty ;
    rdfs:label "precio total"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Importe total registrado para el trabajo."@es .

:tienePlaca a owl:DatatypeProperty ;
    rdfs:label "placa del vehículo"@es ;
    rdfs:domain :Vehiculo ;
    rdfs:range xsd:string .

:moneda a owl:DatatypeProperty ;
    rdfs:label "moneda"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range xsd:string ;
    rdfs:comment "Código de moneda. La base actual no persiste la moneda; confirmar COP o MXN antes de mapear precios reales."@es .

:fechaCreacion a owl:DatatypeProperty ;
    rdfs:label "fecha de creación"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range xsd:dateTime .

:fechaActualizacion a owl:DatatypeProperty ;
    rdfs:label "fecha de actualización"@es ;
    rdfs:domain :TrabajoLavado ;
    rdfs:range xsd:dateTime .

:nombre a owl:DatatypeProperty ;
    rdfs:label "nombre"@es ;
    rdfs:domain :Lavador ;
    rdfs:range xsd:string .

:nombreNegocio a owl:DatatypeProperty ;
    rdfs:label "nombre del negocio"@es ;
    rdfs:domain :Negocio ;
    rdfs:range xsd:string .

:codigoVehiculo a owl:DatatypeProperty ;
    rdfs:label "código de tipo de vehículo"@es ;
    rdfs:domain :TipoVehiculo ;
    rdfs:range xsd:string ;
    rdfs:comment "Valor textual usado por la aplicación para apoyar el mapeo inicial."@es .

:codigoServicio a owl:DatatypeProperty ;
    rdfs:label "código de servicio"@es ;
    rdfs:domain :Servicio ;
    rdfs:range xsd:string ;
    rdfs:comment "Valor textual usado por la aplicación para apoyar el mapeo inicial."@es .

:codigoEstado a owl:DatatypeProperty ;
    rdfs:label "código de estado"@es ;
    rdfs:domain :EstadoLavado ;
    rdfs:range xsd:string ;
    rdfs:comment "Conserva el valor técnico del enum actual: pending, in_progress o completed."@es .

:precioAdicion a owl:DatatypeProperty ;
    rdfs:label "precio de adición"@es ;
    rdfs:domain :Adicion ;
    rdfs:range xsd:decimal .

:precioTarifa a owl:DatatypeProperty ;
    rdfs:label "precio de tarifa"@es ;
    rdfs:domain :TarifaServicio ;
    rdfs:range xsd:decimal .

#################################################################
# Individuos de tipos de vehículo
#################################################################

:Camioneta a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "Camioneta"@es ;
    :codigoVehiculo "Camioneta" .

:Automovil a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "Automóvil"@es ;
    :codigoVehiculo "Automóvil" .

:Moto a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "Moto"@es ;
    :codigoVehiculo "Moto" .

:SUV a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "SUV"@es ;
    :codigoVehiculo "SUV" .

:Pickup a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "Pickup"@es ;
    :codigoVehiculo "Pickup" .

:Van a owl:NamedIndividual, :TipoVehiculo ;
    rdfs:label "Van"@es ;
    :codigoVehiculo "Van" .

#################################################################
# Individuos de servicios
#################################################################

:LavadaGeneral a owl:NamedIndividual, :Servicio ;
    rdfs:label "Lavada General"@es ;
    :codigoServicio "Lavada General" .

:LavadaSencilla a owl:NamedIndividual, :Servicio ;
    rdfs:label "Lavada Sencilla"@es ;
    :codigoServicio "Lavada Sencilla" .

:Latazo a owl:NamedIndividual, :Servicio ;
    rdfs:label "Latazo"@es ;
    :codigoServicio "Latazo" .

:QuitadaDeAsfalto a owl:NamedIndividual, :Servicio ;
    rdfs:label "Quitada de Asfalto"@es ;
    :codigoServicio "Quitada de Asfalto" .

:Lavada a owl:NamedIndividual, :Servicio ;
    rdfs:label "Lavada"@es ;
    :codigoServicio "Lavada" .

:LavadaDesengrasada a owl:NamedIndividual, :Servicio ;
    rdfs:label "Lavada + Desengrasada"@es ;
    :codigoServicio "Lavada + Desengrasada" .

:LavadaPolichada a owl:NamedIndividual, :Servicio ;
    rdfs:label "Lavada + Polichada"@es ;
    :codigoServicio "Lavada + Polichada" .

#################################################################
# Individuos de estado: código técnico actual y etiqueta en español
#################################################################

:Pendiente a owl:NamedIndividual, :EstadoLavado ;
    rdfs:label "Pendiente"@es ;
    :codigoEstado "pending" .

:EnProceso a owl:NamedIndividual, :EstadoLavado ;
    rdfs:label "En proceso"@es ;
    :codigoEstado "in_progress" .

:Completado a owl:NamedIndividual, :EstadoLavado ;
    rdfs:label "Completado"@es ;
    :codigoEstado "completed" .

:Entregado a owl:NamedIndividual, :EstadoLavado ;
    rdfs:label "Entregado"@es ;
    :codigoEstado "delivered" .

#################################################################
# Individuos ficticios para la prueba en Protégé y Fuseki
#################################################################

:NegocioDemo a owl:NamedIndividual, :Negocio ;
    rdfs:label "Negocio de prueba"@es ;
    :nombreNegocio "Negocio de prueba" .

:LavadorDemo01 a owl:NamedIndividual, :Lavador ;
    rdfs:label "Lavador 01 de prueba"@es ;
    :nombre "Lavador de prueba" ;
    :trabajaEn :NegocioDemo .

:AdicionDemo01 a owl:NamedIndividual, :Adicion ;
    rdfs:label "Adición de prueba"@es ;
    :adicionOfrecidaPor :NegocioDemo ;
    rdfs:comment "Individuo ficticio; no representa una adición ni un precio real."@es .

:TrabajoDemo001 a owl:NamedIndividual, :TrabajoLavado ;
    rdfs:label "Trabajo de prueba 001"@es ;
    :realizadoPor :LavadorDemo01 ;
    :tieneTipoVehiculo :SUV ;
    :incluyeServicio :LavadaGeneral ;
    :incluyeAdicion :AdicionDemo01 ;
    :tieneEstado :Completado ;
    :perteneceA :NegocioDemo ;
    :precio "35000.00"^^xsd:decimal ;
    :moneda "COP" ;
    :fechaCreacion "2026-11-16T10:00:00-05:00"^^xsd:dateTime ;
    rdfs:comment "Registro sintético para validar las relaciones. No es un trabajo real de Supabase."@es .

# No se agrega placa ni token QR al grafo de demostración.
# Las membresías, roles y políticas RLS siguen administrándose en Supabase.
# TrabajoDemo001 usa COP solo como dato sintético; confirmar la moneda real antes de importar datos.
